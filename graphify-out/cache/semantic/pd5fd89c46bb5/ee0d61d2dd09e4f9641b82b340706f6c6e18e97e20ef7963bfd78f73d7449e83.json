les_agg)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_costing_model", "label": "Costing model (ingredient, recipe, ingredient_price, dish_cost_snapshot)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_whatsapp_confirm_flow", "label": "WhatsApp write-confirmation sequence", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default expiry 24h matches free-form window; button payload re-checked against DB."}, {"id": "docs_kickoff_09_architecture_role_matrix", "label": "Change-kind role matrix (propose/approve)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_sr_erp_push", "label": "SR ERP/PMS JSON push adapter", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sanctioned by National Soft, ticket-level, near-real-time; module price unverified."}, {"id": "docs_kickoff_09_architecture_sr_connector", "label": "Local SR DB connector (fallback)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unresolved EULA clause and Windows/SQL support burden; medium legal risk."}, {"id": "docs_kickoff_09_architecture_cfdi_parser", "label": "CFDI 4.0 XML parser", "file_t