{"nodes": [{"id": "docs_kickoff_09_architecture", "label": "09 Architecture", "file_type": "document", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_d1", "label": "D1 POS-agnostic normalized Postgres model", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every fact row carries tenant_id, location_id, source_id, external_id, batch_id. SR is source #1 of several; own POS writes same tables in Phase 3."}, {"id": "docs_kickoff_09_architecture_d2", "label": "D2 Transports vs parsers adapter split", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same SR file can arrive via WhatsApp or email, so each parser is written once."}, {"id": "docs_kickoff_09_architecture_d3", "label": "D3 Insert-only batch-scoped facts", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rollback/correction flips batch status, never deletes rows; meets reviewable-and-reversible rule."}, {"id": "docs_kickoff_09_architecture_d4", "label": "D4 Two fact grains: ticket and aggregate", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SR exports are mostly aggregated; ERP push, connector and POS are ticket-level; metrics read one unified daily view."}, {"id": "docs_kickoff_09_architecture_d5", "label": "D5 Metrics layer as Postgres SQL RPCs", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent, dashboard and POS share one implementation; numbers computed once in SQL, called via PostgREST under RLS."}, {"id": "docs_kickoff_09_architecture_d6", "label": "D6 Deterministic router first, LLM second", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Token cost (about US$0.66/restaurant/month) and owner trust; number validator rejects numbers not in tool output."}, {"id": "docs_kickoff_09_architecture_d7", "label": "D7 Writes only through pending_change", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent's only write tool is propose_change; apply_pending_change() after role-checked human approval; append-only audit_log. Channel-agnostic human-approval rule."}, {"id": "docs_kickoff_09_architecture_d8", "label": "D8 Tool calls run as the user (short-lived JWT)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS applies to agent reads; prompt-injection or tool-argument bug cannot cross tenants. Service role only for ingestion and apply functions."}, {"id": "docs_kickoff_09_architecture_d9", "label": "D9 Python backend, TypeScript frontend, Supabase", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python stronger for Excel parsing and LLM work; Pydantic JSON Schema generates TS types; generation pipeline untested, allow half a day in Phase 2."}, {"id": "docs_kickoff_09_architecture_transport", "label": "Ingestion transports (WhatsApp, email, HTTP push)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_parser_registry", "label": "Parser registry (fingerprint to parser)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Picks parser by sheet names, header row, XML namespace; parsers are pure functions tested with golden files."}, {"id": "docs_kickoff_09_architecture_normalized_batch", "label": "NormalizedBatch contract", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_batch_loader", "label": "Batch loader (validate, stage, apply)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_agent_core", "label": "Agent core (router, templates, LLM broker, validator)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_confirmation_service", "label": "Confirmation service", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_llm_gateway", "label": "LLM gateway (routing, caps, metering)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_procrastinate", "label": "Procrastinate jobs on Postgres", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retries, cron, idempotency with no extra infra; pg-boss is Node-only; pg_cron fallback."}, {"id": "docs_kickoff_09_architecture_pending_change", "label": "pending_change table", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_kickoff_09_architecture_audit_log", "label": "audit_log table (append-only)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trigger blocks UPDATE/DELETE and no grants for either."}, {"id": "docs_kickoff_09_architecture_import_batch", "label": "import_batch table and lifecycle", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "States received/parsed/needs_review/applied/rolled_back/superseded/rejected; clean uploads auto-apply with Deshacer button."}, {"id": "docs_kickoff_09_architecture_metric_rpcs", "label": "Metric RPCs v1 (12 agent tools)", "file_type": "concept", "source_file": "docs/kickoff/09-architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SECURITY INVOKER SQL functions; one envelope {ok,data,flags,meta}; each result under about 400 tokens."}, {"id": "docs_kickoff_09_architecture_propose_change", "label": "propose_change tool", "file_type": "concept", "source_file": "docs/kicko