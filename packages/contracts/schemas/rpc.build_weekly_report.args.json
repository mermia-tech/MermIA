    "location_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location Id"
    },
    "period": {
      "anyOf": [
        {
          "enum": [
            "last_week",
            "prev_week"
          ],
          "type": "string"
