[
  {
    "description": "Net sales, tickets, average ticket, guests, discounts and cancellations.",
    "input_schema": {
      "$defs": {
        "Period": {
          "additionalProperties": false,
          "description": "Business dates covered by the batch, both inclusive.",
          "properties": {
            "from": {
              "format": "date",
              "type": "string"
            },
            "to": {
              "format": "date",
              "type": "string"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "period": {
          "anyOf": [
            {
              "enum": [
                "today",
                "yesterday",
                "this_week",
                "last_week",
                "prev_week",
                "this_month",
                "last_month",
                "last_7d",
                "last_30d"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/Period"
            }
          ]
        }
      },
      "required": [
        "period"
      ],
      "type": "object"
    },
    "name": "get_sales_summary"
  },
  {
    "description": "Compare one metric between two periods.",
    "input_schema": {
      "$defs": {
        "Period": {
          "additionalProperties": false,
          "description": "Business dates covered by the batch, both inclusive.",
          "properties": {
