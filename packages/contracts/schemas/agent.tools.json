            "to"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "location_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metric": {
          "enum": [
            "net_sales",
            "tickets",
            "avg_ticket",
            "guests",
            "food_cost_pct",
            "units"
          ],
          "type": "string"
        },
        "period_a": {
          "anyOf": [
            {
              "enum": [
                "today",
                "yesterday",
                "this_week",
                "last_week",
                "prev_week",
                "this_month",
                "last_month",
                "last_7d",
                "last_30d"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/Period"
            }
          ]
        },
        "period_b": {
          "anyOf": [
            {
              "enum": [
                "today",
                "yesterday",
                "this_week",
                "last_week",
                "prev_week",
                "this_month",
                "last_month",
                "last_7d",
                "last_30d"
              ],
              "type": "string"
            },
            {
              "$ref": "#/$defs/Period"
            }
          ]
        }
      },
      "required": [
        "metric",
        "period_a",
        "period_b"
      ],
      "type": "object"
    },
    "name": "compare_periods"
  },
