{
  "$defs": {
    "BasePrice": {
      "additionalProperties": false,
      "description": "A price per BASE unit. `raw` is pesos per `base_unit` (g, ml or pza), never per pack, as\ningredient_price.unit_price_net stores it. `text` is the amount in the unit the owner uses,\nformatted (\"$220.00/kg\"): quote it, do not convert `raw`.",
      "properties": {
        "base_unit": {
          "$ref": "#/$defs/BaseUnit"
        },
        "raw": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "unit=pesos_per_base_unit (g, ml or pza), never per purchase unit; greater than zero",
          "title": "Raw"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "base_unit",
        "text"
      ],
      "title": "BasePrice",
      "type": "object"
    },
    "BaseUnit": {
      "enum": [
        "g",
        "ml",
        "pza"
      ],
      "title": "BaseUnit",
      "type": "string"
    },
    "CostAlertsData": {
      "additionalProperties": false,
      "description": "Ingredient price moves, dishes over target and price suggestions (MR-33).\n\nDoc 13 keeps tool results small (top N only): `price_moves` holds the 10 largest moves (by\nsize, either way; listed by start day) and `suggestions` the 10 highest food costs; the\n`*_total` fields count every row, so the agent can say how many more there are.",
      "properties": {
        "breaches": {
          "items": {
            "$ref": "#/$defs/TargetBreach"
          },
          "title": "Breaches",
          "type": "array"
        },
        "price_moves": {
          "items": {
            "$ref": "#/$defs/PriceMove"
          },
          "maxItems": 10,
          "title": "Price Moves",
          "type": "array"
        },
        "price_moves_total": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Price Moves Total",
          "type": "integer"
        },
        "suggestions": {
          "items": {
            "$ref": "#/$defs/PriceSuggestion"
          },
          "maxItems": 10,
          "title": "Suggestions",
          "type": "array"
        },
        "suggestions_total": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Suggestions Total",
          "type": "integer"
        }
      },
      "required": [
        "price_moves",
        "price_moves_total",
        "breaches",
        "suggestions",
        "suggestions_total"
      ],
      "title": "CostAlertsData",
      "type": "object"
    },
    "CostConfidence": {
      "enum": [
        "confirmed",
        "estimated",
        "missing"
      ],
      "title": "CostConfidence",
      "type": "string"
    },
    "Flag": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "code"
      ],
      "title": "Flag",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "`period_resolved` is the one range a single-period RPC answered for (null for none, and\nfor compare_periods, which carries both ranges in its data).",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "coverage_pct": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "description": "unit=percent_points (calculated, 4 decimals)"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Pct"
        },
        "period_resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "as_of"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Pct": {
      "additionalProperties": false,
      "description": "A calculated percentage in percent points (+7.2 is 7.2 %), not a database column.",
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "unit=percent_points (calculated, 4 decimals)",
          "title": "Raw"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "text"
      ],
      "title": "Pct",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "Business dates covered by the batch, both inclusive.",
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "Period",
      "type": "object"
    },
    "PositiveMoney": {
      "additionalProperties": false,
      "description": "Money greater than zero: a price a dish is sold at.",
      "properties": {
        "raw": {
          "description": "unit=centavos, greater than zero",
          "exclusiveMinimum": 0,
          "maximum": 9223372036854775807,
          "title": "Raw",
          "type": "integer"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "text"
      ],
      "title": "PositiveMoney",
      "type": "object"
    },
    "PriceMove": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "#/$defs/Pct"
        },
        "ingredient": {
          "pattern": "\\S",
          "title": "Ingredient",
          "type": "string"
        },
        "new_unit_price": {
          "$ref": "#/$defs/BasePrice"
        }
      },
      "required": [
        "ingredient",
        "change",
        "new_unit_price"
      ],
      "title": "PriceMove",
      "type": "object"
    },
    "PriceSuggestion": {
      "additionalProperties": false,
      "description": "A menu price suggestion for a dish at a location that breaches the target (MR-33).\n\nEvery price here is a MENU price with IVA included, the price on the menu (settles MR-11 spec\n7.2): `current_price` is the menu price today, `target_price` the lowest price that reaches the\ntarget food cost (to the centavo, not rounded to a price point), `suggested_price` the price\npoint to propose. `change` is suggested vs current; `new_food_cost` the food cost (on the net\nprice, as everywhere) at the suggested price. A review (`review_portion_cost`) has no\nsuggested price, change or new food cost. `confidence` is the cost's (confirmed: fresh CFDI\nprices and confirmed recipes). Stars and resale items (bottled drinks) never appear.\n\"Cambiar precios\" proposes a `menu_item_price.set` pending change for `location_id`.",
      "properties": {
        "change": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pct"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/CostConfidence"
        },
        "current_price": {
          "$ref": "#/$defs/PositiveMoney"
        },
        "location_id": {
          "format": "uuid",
          "title": "Location Id",
          "type": "string"
        },
        "menu_item_id": {
          "format": "uuid",
          "title": "Menu Item Id",
          "type": "string"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "new_food_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pct"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale_code": {
          "$ref": "#/$defs/SuggestionRationale"
        },
        "suggested_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveMoney"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_price": {
          "$ref": "#/$defs/PositiveMoney"
        }
      },
      "required": [
        "menu_item_id",
        "location_id",
        "name",
        "current_price",
        "target_price",
        "suggested_price",
        "change",
        "new_food_cost",
        "confidence",
        "rationale_code"
      ],
      "title": "PriceSuggestion",
      "type": "object"
    },
    "RpcError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/RpcErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RpcError",
      "type": "object"
    },
    "RpcErrorCode": {
      "enum": [
        "invalid_args",
        "not_found",
        "no_data",
        "forbidden",
        "internal"
      ],
      "title": "RpcErrorCode",
      "type": "string"
    },
    "SuggestionRationale": {
      "description": "Why a dish gets this suggestion (03 \"Price-suggestion formula\", MR-33 decision U4).",
      "enum": [
        "raise_to_target",
        "raise_capped",
        "review_portion_cost"
      ],
      "title": "SuggestionRationale",
      "type": "string"
    },
    "TargetBreach": {
      "additionalProperties": false,
      "properties": {
        "food_cost": {
          "$ref": "#/$defs/Pct"
        },
        "menu_item_id": {
          "format": "uuid",
          "title": "Menu Item Id",
          "type": "string"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Pct"
        }
      },
      "required": [
        "menu_item_id",
        "name",
        "food_cost",
        "target"
      ],
      "title": "TargetBreach",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostAlertsData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RpcError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/Flag"
      },
      "title": "Flags",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    }
  },
  "required": [
    "ok",
    "meta"
  ],
  "title": "RpcEnvelope[CostAlertsData]",
  "type": "object"
}
