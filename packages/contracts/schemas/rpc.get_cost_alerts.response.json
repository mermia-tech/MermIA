{
  "$defs": {
    "BasePrice": {
      "additionalProperties": false,
      "description": "A price per BASE unit. `raw` is pesos per `base_unit` (g, ml or pza), never per pack, as\ningredient_price.unit_price_net stores it. `text` is the amount in the unit the owner uses,\nformatted (\"$220.00/kg\"): quote it, do not convert `raw`.",
      "properties": {
        "base_unit": {
          "$ref": "#/$defs/BaseUnit"
        },
        "raw": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "unit=pesos_per_base_unit (g, ml or pza), never per purchase unit; greater than zero",
          "title": "Raw"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "base_unit",
        "text"
      ],
      "title": "BasePrice",
      "type": "object"
    },
    "BaseUnit": {
      "enum": [
        "g",
        "ml",
        "pza"
      ],
      "title": "BaseUnit",
      "type": "string"
    },
    "CostAlertsData": {
      "additionalProperties": false,
      "properties": {
        "breaches": {
          "items": {
            "$ref": "#/$defs/TargetBreach"
          },
          "title": "Breaches",
          "type": "array"
        },
        "price_moves": {
          "items": {
            "$ref": "#/$defs/PriceMove"
          },
          "title": "Price Moves",
          "type": "array"
        },
        "suggestions": {
          "items": {
            "$ref": "#/$defs/PriceSuggestion"
          },
          "title": "Suggestions",
          "type": "array"
        }
      },
      "required": [
        "price_moves",
        "breaches",
        "suggestions"
      ],
      "title": "CostAlertsData",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "code"
      ],
      "title": "Flag",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "description": "`period_resolved` is the one range a single-period RPC answered for (null for none, and\nfor compare_periods, which carries both ranges in its data).",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "coverage_pct": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "description": "unit=percent_points (calculated, 4 decimals)"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Pct"
        },
        "period_resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "as_of"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "description": "unit=centavos",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Raw",
          "type": "integer"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "text"
      ],
      "title": "Money",
      "type": "object"
    },
    "Pct": {
      "additionalProperties": false,
      "description": "A calculated percentage in percent points (+7.2 is 7.2 %), not a database column.",
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "unit=percent_points (calculated, 4 decimals)",
          "title": "Raw"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "text"
      ],
      "title": "Pct",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "Business dates covered by the batch, both inclusive.",
      "properties": {
        "from": {
          "format": "date",
          "title": "From",
          "type": "string"
        },
        "to": {
          "format": "date",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "Period",
      "type": "object"
    },
    "PriceMove": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "$ref": "#/$defs/Pct"
        },
        "ingredient": {
          "pattern": "\\S",
          "title": "Ingredient",
          "type": "string"
        },
        "new_unit_price": {
          "$ref": "#/$defs/BasePrice"
        }
      },
      "required": [
        "ingredient",
        "change",
        "new_unit_price"
      ],
      "title": "PriceMove",
      "type": "object"
    },
    "PriceSuggestion": {
      "additionalProperties": false,
      "description": "`price_suggestion` has a free-text `subject` and no dish id or current price, so\n`menu_item_id` and `current_price` are present only when the subject resolves to a dish.",
      "properties": {
        "current_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "menu_item_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Menu Item Id"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "suggested_price": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "name",
        "suggested_price"
      ],
      "title": "PriceSuggestion",
      "type": "object"
    },
    "RpcError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/RpcErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RpcError",
      "type": "object"
    },
    "RpcErrorCode": {
      "enum": [
        "invalid_args",
        "not_found",
        "no_data",
        "forbidden",
        "internal"
      ],
      "title": "RpcErrorCode",
      "type": "string"
    },
    "TargetBreach": {
      "additionalProperties": false,
      "properties": {
        "food_cost": {
          "$ref": "#/$defs/Pct"
        },
        "menu_item_id": {
          "format": "uuid",
          "title": "Menu Item Id",
          "type": "string"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Pct"
        }
      },
      "required": [
        "menu_item_id",
        "name",
        "food_cost",
        "target"
      ],
      "title": "TargetBreach",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostAlertsData"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RpcError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/Flag"
      },
      "title": "Flags",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "ok": {
      "title": "Ok",
      "type": "boolean"
    }
  },
  "required": [
    "ok",
    "meta"
  ],
  "title": "RpcEnvelope[CostAlertsData]",
  "type": "object"
}
