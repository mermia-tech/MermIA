{
  "$defs": {
    "Choice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 24,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Choice",
      "type": "object"
    },
    "ChoicesMsg": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "choices",
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "options"
      ],
      "title": "ChoicesMsg",
      "type": "object"
    },
    "JsonValue": {},
    "MetricCardMsg": {
      "additionalProperties": false,
      "description": "A card for one RPC result. `data` must be that RPC's complete `data` (rpc.RPCS), as\nreturned; web and POS render it and WhatsApp flattens it to text. There is no partial card:\nshowing a single metric would need a message type of its own.",
      "properties": {
        "data": {
          "$ref": "#/$defs/JsonValue",
          "description": "the data of `rpc`, complete, as the RPC returned it"
        },
        "kind": {
          "const": "metric_card",
          "title": "Kind",
          "type": "string"
        },
        "rpc": {
          "title": "Rpc",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "rpc",
        "data"
      ],
      "title": "MetricCardMsg",
      "type": "object"
    },
    "TextMsg": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "TextMsg",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "messages": {
      "items": {
        "discriminator": {
          "mapping": {
            "choices": "#/$defs/ChoicesMsg",
            "metric_card": "#/$defs/MetricCardMsg",
            "text": "#/$defs/TextMsg"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TextMsg"
          },
          {
            "$ref": "#/$defs/ChoicesMsg"
          },
          {
            "$ref": "#/$defs/MetricCardMsg"
          }
        ]
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "route": {
      "enum": [
        "handler",
        "template",
        "haiku",
        "sonnet",
        "fallback"
      ],
      "title": "Route",
      "type": "string"
    },
    "usage_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage Id"
    }
  },
  "required": [
    "messages",
    "route"
  ],
  "title": "AgentResponse",
  "type": "object"
}
