      },
      "required": [
        "severity",
        "code",
        "message_es"
      ],
      "title": "IssueIn",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "IssueSeverity",
      "type": "string"
