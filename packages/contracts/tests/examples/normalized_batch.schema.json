        "ticket",
        "item_daily",
        "daily",
        "purchase",
        "catalog"
      ],
      "title": "Grain",
      "type": "string"
    },
    "IssueIn": {
      "additionalProperties": false,
      "description": "Columns: import_issue. message_es is shown to the manager in Spanish.",
      "properties": {
        "code": {
          "pattern": "^[a-z0-9_.]+$",
          "title": "Code",
          "type": "string"
        },
        "message_es": {
          "pattern": "\\S",
          "title": "Message Es",
          "type": "string"
        },
        "row_ref": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
