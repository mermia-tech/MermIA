      "additionalProperties": false,
      "description": "PROVISIONAL: \"Productos vendidos\" columns for SR 10-12 are unverified.\n\nColumns: item_sales_agg. The item is resolved to menu_item_id by the loader.",
      "properties": {
        "discount": {
          "description": "unit=centavos",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Discount",
          "type": "integer"
        },
        "gross": {
          "description": "unit=centavos",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Gross",
          "type": "integer"
        },
        "item_external_id": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item External Id"
        },
        "item_name": {
          "pattern": "\\S",
          "title": "Item Name",
          "type": "string"
        },
        "net": {
          "description": "unit=centavos",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Net",
          "type": "integer"
        },
        "period_from": {
          "format": "date",
          "title": "Period From",
