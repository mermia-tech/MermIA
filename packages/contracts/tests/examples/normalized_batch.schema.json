        "business_date": {
          "format": "date",
          "title": "Business Date",
          "type": "string"
        },
        "cancellations_amount": {
          "anyOf": [
            {
              "description": "unit=centavos",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancellations Amount"
        },
        "cancellations_count": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancellations Count"
        },
        "discounts": {
          "anyOf": [
            {
              "description": "unit=centavos",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discounts"
        },
        "guests": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guests"
        },
        "net_sales": {
          "description": "unit=centavos",
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Net Sales",
          "type": "integer"
        },
        "payment_mix": {
          "additionalProperties": {
            "description": "unit=centavos",
            "maximum": 9223372036854775807,
            "minimum": -9223372036854775808,
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/PaymentMethod"
          },
          "title": "Payment Mix",
          "type": "object"
        },
        "tax": {
          "anyOf": [
            {
              "description": "unit=centavos",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax"
        },
        "tickets": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tickets"
        },
        "tips": {
          "anyOf": [
            {
              "description": "unit=centavos",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
